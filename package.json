{
  "name": "thoock-landing-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run release:check && tsc -b && vite build && node scripts/prerender.mjs && node scripts/check-prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && playwright test",
    "assets:optimize": "node scripts/optimize-screenshots.mjs",
    "test:readiness": "node --test scripts/wait-for-http.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:stage": "node scripts/stage-desktop-release.mjs",
    "test:release": "node --test scripts/check-release-http.test.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs && node scripts/optimize-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lighthouse": "^13.0.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
