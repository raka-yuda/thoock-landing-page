# Public Umami tracking values, embedded at build time. Leave both empty to disable.
# Create a separate website for thoock.ryuda.me in your existing Umami instance.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# Public payment-service origin. Use http://localhost:3000 for local development.
# Production requires its public HTTPS origin. Never put payment credentials here.
VITE_PAYMENT_BASE_URL=http://localhost:3000
